{
  "name": "paper-review-tool",
  "displayName": "Paper Review Tool",
  "description": "单文件 LaTeX 写作、AI 修改审计与 Issue 管理。",
  "version": "0.3.9",
  "publisher": "local-paper-tools",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.103.2"
  },
  "main": "./src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:paper",
    "onStartupFinished",
    "onFileSystem:paper-issue"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "paper-build-log",
        "aliases": [
          "Paper Build Log"
        ]
      }
    ],
    "commands": [
      {
        "command": "paperReview.open",
        "title": "Paper: 打开 Human Draft"
      },
      {
        "command": "paperReview.openProject",
        "title": "Paper: 初始化 / 打开项目",
        "icon": "$(folder-opened)"
      },
      {
        "command": "paperReview.closeProject",
        "title": "Paper: 关闭项目",
        "icon": "$(close)"
      },
      {
        "command": "paperReview.copyCliPath",
        "title": "Paper: 复制旧 CLI 路径"
      },
      {
        "command": "paperReview.push",
        "title": "Paper: Push",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "paperReview.compile",
        "title": "Paper: Push + 编译",
        "icon": "$(play)",
        "enablement": "paperReview.projectOpen && !paperReview.compiling"
      },
      {
        "command": "paperReview.openChatGPTExternal",
        "title": "Paper: 在默认浏览器打开 ChatGPT Web"
      },
      {
        "command": "paperReview.copyChatGPTScript",
        "title": "Paper: 复制 ChatGPT Web LaTeX 源码脚本"
      },
      {
        "command": "paperReview.openPdf",
        "title": "Paper: 打开 PDF",
        "icon": "$(file-pdf)",
        "enablement": "paperReview.projectOpen"
      },
      {
        "command": "paperReview.cancelCompile",
        "title": "Paper: 停止编译",
        "icon": "$(debug-stop)",
        "enablement": "paperReview.compiling"
      },
      {
        "command": "paperReview.buildLog",
        "title": "Paper: 打开 / 隐藏编译日志",
        "icon": "$(output)"
      },
      {
        "command": "paperReview.state",
        "title": "Paper: 查看项目状态"
      },
      {
        "command": "paperReview.refresh",
        "title": "Paper: 刷新章节与 Issues",
        "icon": "$(refresh)"
      },
      {
        "command": "paperReview.locate",
        "title": "Paper: 定位正文"
      },
      {
        "command": "paperReview.approve",
        "title": "Paper: 通过审核"
      },
      {
        "command": "paperReview.unreviewed",
        "title": "Paper: 标黄（待审核）"
      },
      {
        "command": "paperReview.needsFix",
        "title": "Paper: 标红（需修改）"
      },
      {
        "command": "paperReview.reject",
        "title": "Paper: 拒绝修改"
      },
      {
        "command": "paperReview.createIssue",
        "title": "Paper: 新建 Issue",
        "icon": "$(add)"
      },
      {
        "command": "paperReview.editIssue",
        "title": "Paper: 编辑 Issue"
      },
      {
        "command": "paperReview.rebindIssue",
        "title": "Paper: 重新绑定 Issue"
      },
      {
        "command": "paperReview.toggleIssue",
        "title": "Paper: 解决 / 重新打开 Issue"
      },
      {
        "command": "paperReview.showIssue",
        "title": "Paper: 查看 Issue"
      },
      {
        "command": "paperReview.resolveConflict",
        "title": "Paper: 打开冲突",
        "icon": "$(warning)"
      },
      {
        "command": "paperReview.submitConflict",
        "title": "Paper: 提交合并结果",
        "icon": "$(check-all)"
      },
      {
        "command": "paperReview.snapshot",
        "title": "Paper: 保存 Git 阶段版本"
      },
      {
        "command": "paperReview.events",
        "title": "Paper: 查看 AI 修改历史"
      },
      {
        "command": "paperReview.history",
        "title": "Paper: 查看 Master 修订历史"
      },
      {
        "command": "paperReview.restore",
        "title": "Paper: 恢复 Master 历史版本"
      },
      {
        "command": "paperReview.deleteIssue",
        "title": "Paper: 删除 Issue",
        "icon": "$(trash)"
      },
      {
        "command": "paperReview.locateIssue",
        "title": "Paper: 定位 Issue",
        "icon": "$(go-to-file)"
      },
      {
        "command": "paperReview.showOutline",
        "title": "Paper: 显示章节",
        "icon": "$(list-tree)"
      },
      {
        "command": "paperReview.reloadPdf",
        "title": "Paper: 重新加载 PDF",
        "icon": "$(refresh)",
        "enablement": "paperReview.projectOpen"
      },
      {
        "command": "paperReview.updateOnly",
        "title": "Paper: Update Only（放弃本地修改）",
        "icon": "$(cloud-download)"
      },
      {
        "command": "paperReview.mergeUpdate",
        "title": "Paper: Merge Update（合并并更新）",
        "icon": "$(git-merge)"
      },
      {
        "command": "paperReview.copyAgentPrompt",
        "title": "Paper: Agent Instruction",
        "icon": "$(copy)"
      },
      {
        "command": "paperReview.openAgent",
        "title": "Paper: 打开默认 Agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "paperReview.openWeb",
        "title": "Paper: 打开默认 Web",
        "icon": "$(globe)"
      },
      {
        "command": "paperReview.selectCompileProfile",
        "title": "Paper: 编译设置",
        "icon": "$(list-selection)"
      },
      {
        "command": "paperReview.configureAgent",
        "title": "Paper: 配置默认 Agent"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "paperReview.push",
          "when": "resourceScheme == paper",
          "group": "navigation@1"
        },
        {
          "command": "paperReview.mergeUpdate",
          "when": "resourceScheme == paper",
          "group": "navigation@2"
        },
        {
          "command": "paperReview.compile",
          "when": "resourceScheme == paper && !paperReview.compiling",
          "group": "navigation@3"
        },
        {
          "command": "paperReview.cancelCompile",
          "when": "resourceScheme == paper && paperReview.compiling",
          "group": "navigation@3"
        },
        {
          "command": "paperReview.updateOnly",
          "when": "resourceScheme == paper",
          "group": "1_document@0"
        },
        {
          "command": "paperReview.openPdf",
          "when": "resourceScheme == paper",
          "group": "1_document@1"
        },
        {
          "command": "paperReview.reloadPdf",
          "when": "resourceScheme == paper",
          "group": "1_document@2"
        },
        {
          "command": "paperReview.selectCompileProfile",
          "when": "resourceScheme == paper",
          "group": "2_build@0"
        },
        {
          "command": "paperReview.buildLog",
          "when": "resourceScheme == paper",
          "group": "2_build@1"
        },
        {
          "command": "paperReview.openAgent",
          "when": "resourceScheme == paper",
          "group": "3_agent@0"
        },
        {
          "command": "paperReview.openWeb",
          "when": "resourceScheme == paper",
          "group": "3_agent@1"
        },
        {
          "command": "paperReview.copyAgentPrompt",
          "when": "resourceScheme == paper",
          "group": "3_agent@2"
        },
        {
          "command": "paperReview.openProject",
          "when": "resourceScheme == paper",
          "group": "4_project@1"
        },
        {
          "command": "paperReview.locateIssue",
          "when": "resourceScheme == paper-issue",
          "group": "navigation@1"
        },
        {
          "command": "paperReview.deleteIssue",
          "when": "resourceScheme == paper-issue",
          "group": "issue@9"
        },
        {
          "command": "paperReview.submitConflict",
          "when": "paperReview.conflictPrepared && resourceFilename == result.tex",
          "group": "navigation@0"
        }
      ],
      "editor/context": [
        {
          "command": "paperReview.approve",
          "when": "resourceScheme == paper",
          "group": "paperReview@1"
        },
        {
          "command": "paperReview.unreviewed",
          "when": "resourceScheme == paper",
          "group": "paperReview@1.5"
        },
        {
          "command": "paperReview.needsFix",
          "when": "resourceScheme == paper",
          "group": "paperReview@2"
        },
        {
          "command": "paperReview.reject",
          "when": "resourceScheme == paper",
          "group": "paperReview@3"
        },
        {
          "command": "paperReview.createIssue",
          "when": "resourceScheme == paper",
          "group": "paperReview@4"
        }
      ],
      "view/title": [
        {
          "command": "paperReview.openProject",
          "when": "view == paperReview.reviews",
          "group": "navigation@1"
        },
        {
          "command": "paperReview.refresh",
          "when": "paperReview.projectOpen && view == paperReview.reviews",
          "group": "navigation@2"
        },
        {
          "command": "paperReview.createIssue",
          "when": "paperReview.projectOpen && view == paperReview.issues",
          "group": "navigation@1"
        },
        {
          "command": "paperReview.refresh",
          "when": "paperReview.projectOpen && view == paperReview.issues",
          "group": "navigation@2"
        },
        {
          "command": "paperReview.push",
          "when": "paperReview.projectOpen && view == paperReview.reviews",
          "group": "1_document@0"
        },
        {
          "command": "paperReview.mergeUpdate",
          "when": "paperReview.projectOpen && view == paperReview.reviews",
          "group": "1_document@1"
        },
        {
          "command": "paperReview.updateOnly",
          "when": "paperReview.projectOpen && view == paperReview.reviews",
          "group": "1_document@2"
        },
        {
          "command": "paperReview.openPdf",
          "when": "paperReview.projectOpen && view == paperReview.reviews",
          "group": "1_document@3"
        },
        {
          "command": "paperReview.reloadPdf",
          "when": "paperReview.projectOpen && view == paperReview.reviews",
          "group": "1_document@4"
        },
        {
          "command": "paperReview.selectCompileProfile",
          "when": "paperReview.projectOpen && view == paperReview.reviews",
          "group": "2_build@0"
        },
        {
          "command": "paperReview.buildLog",
          "when": "paperReview.projectOpen && view == paperReview.reviews",
          "group": "2_build@1"
        },
        {
          "command": "paperReview.openAgent",
          "when": "view == paperReview.reviews",
          "group": "3_agent@0"
        },
        {
          "command": "paperReview.openWeb",
          "when": "view == paperReview.reviews",
          "group": "3_agent@1"
        },
        {
          "command": "paperReview.copyAgentPrompt",
          "when": "view == paperReview.reviews",
          "group": "3_agent@2"
        },
        {
          "command": "paperReview.state",
          "when": "paperReview.projectOpen && view == paperReview.reviews",
          "group": "4_project@0"
        },
        {
          "command": "paperReview.events",
          "when": "paperReview.projectOpen && view == paperReview.reviews",
          "group": "4_project@1"
        },
        {
          "command": "paperReview.history",
          "when": "paperReview.projectOpen && view == paperReview.reviews",
          "group": "4_project@2"
        },
        {
          "command": "paperReview.closeProject",
          "when": "paperReview.projectOpen && view == paperReview.reviews",
          "group": "4_project@3"
        },
        {
          "command": "paperReview.resolveConflict",
          "when": "paperReview.projectOpen && view == paperReview.issues",
          "group": "navigation@0"
        },
        {
          "command": "paperReview.submitConflict",
          "when": "paperReview.conflictPrepared && view == paperReview.issues",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "paperReview.openProject",
          "when": "resourceScheme == file && resourceExtname == .tex",
          "group": "paperReview"
        }
      ],
      "view/item/context": [
        {
          "command": "paperReview.editIssue",
          "when": "viewItem =~ /^issue/",
          "group": "issue@1"
        },
        {
          "command": "paperReview.toggleIssue",
          "when": "viewItem =~ /^issue/",
          "group": "issue@2"
        },
        {
          "command": "paperReview.rebindIssue",
          "when": "viewItem =~ /^issue/",
          "group": "issue@3"
        },
        {
          "command": "paperReview.resolveConflict",
          "when": "viewItem == issueConflict",
          "group": "issue@4"
        },
        {
          "command": "paperReview.submitConflict",
          "when": "viewItem == issueConflict",
          "group": "issue@5"
        },
        {
          "command": "paperReview.deleteIssue",
          "when": "viewItem =~ /^issue/",
          "group": "inline@9"
        },
        {
          "command": "paperReview.locateIssue",
          "when": "viewItem =~ /^issue/",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "paperReview.copyCliPath",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "paperReview",
          "title": "Paper",
          "icon": "resources/paper.svg"
        }
      ]
    },
    "views": {
      "paperReview": [
        {
          "id": "paperReview.reviews",
          "name": "章节"
        },
        {
          "id": "paperReview.outline",
          "name": "章节",
          "when": "false"
        },
        {
          "id": "paperReview.issues",
          "name": "Issues"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "paperReview.reviews",
        "when": "!paperReview.projectOpen",
        "contents": "选择受管理的 .tex 文件，加载草稿与项目数据。\n[初始化 / 打开项目](command:paperReview.openProject)"
      },
      {
        "view": "paperReview.issues",
        "when": "!paperReview.projectOpen",
        "contents": "打开项目后管理 Issue。\n[初始化 / 打开项目](command:paperReview.openProject)"
      }
    ],
    "configuration": {
      "title": "Paper Review Tool",
      "properties": {
        "paperReview.agentTargets": {
          "type": "array",
          "default": [],
          "description": "兼容旧配置的 Agent 列表。",
          "restricted": true,
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "extensionId": {
                "type": "string"
              },
              "args": {
                "type": "array"
              }
            }
          },
          "included": false
        },
        "paperReview.webTargets": {
          "type": "array",
          "default": [
            {
              "name": "ChatGPT Web",
              "url": "https://chatgpt.com/"
            },
            {
              "name": "Claude Web",
              "url": "https://claude.ai/"
            }
          ],
          "description": "兼容旧配置的 Web 列表。",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          },
          "included": false
        },
        "paperReview.compileProfile": {
          "type": "string",
          "enum": [
            "pdflatex",
            "pdflatex-bibtex",
            "xelatex",
            "xelatex-bibtex",
            "other",
            "none"
          ],
          "enumItemLabels": [
            "pdfLaTeX",
            "pdfLaTeX + BibTeX",
            "XeLaTeX",
            "XeLaTeX + BibTeX",
            "其他",
            "不编译"
          ],
          "default": "pdflatex-bibtex",
          "description": "选择引擎；“其他”打开自定义方案。",
          "order": 31,
          "restricted": true,
          "title": "编译引擎"
        },
        "paperReview.compileProfiles": {
          "type": "array",
          "default": [
            {
              "id": "pdflatex",
              "name": "pdfLaTeX",
              "steps": [
                {
                  "command": "pdflatex",
                  "args": [
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "-no-shell-escape",
                    "${file}"
                  ]
                }
              ]
            },
            {
              "id": "pdflatex-bibtex",
              "name": "pdfLaTeX + BibTeX",
              "steps": [
                {
                  "command": "pdflatex",
                  "args": [
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "-no-shell-escape",
                    "${file}"
                  ]
                },
                {
                  "command": "bibtex",
                  "args": [
                    "${stem}"
                  ],
                  "ifBibliography": true
                },
                {
                  "command": "pdflatex",
                  "args": [
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "-no-shell-escape",
                    "${file}"
                  ]
                },
                {
                  "command": "pdflatex",
                  "args": [
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "-no-shell-escape",
                    "${file}"
                  ]
                }
              ]
            },
            {
              "id": "xelatex",
              "name": "XeLaTeX",
              "steps": [
                {
                  "command": "xelatex",
                  "args": [
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "-no-shell-escape",
                    "${file}"
                  ]
                }
              ]
            },
            {
              "id": "xelatex-bibtex",
              "name": "XeLaTeX + BibTeX",
              "steps": [
                {
                  "command": "xelatex",
                  "args": [
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "-no-shell-escape",
                    "${file}"
                  ]
                },
                {
                  "command": "bibtex",
                  "args": [
                    "${stem}"
                  ],
                  "ifBibliography": true
                },
                {
                  "command": "xelatex",
                  "args": [
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "-no-shell-escape",
                    "${file}"
                  ]
                },
                {
                  "command": "xelatex",
                  "args": [
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "-no-shell-escape",
                    "${file}"
                  ]
                }
              ]
            },
            {
              "id": "none",
              "name": "不编译",
              "steps": []
            }
          ],
          "description": "兼容旧配置的编译方案列表。",
          "restricted": true,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "steps"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "command",
                    "args"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "command": {
                      "type": "string",
                      "minLength": 1
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "ifBibliography": {
                      "type": "boolean",
                      "default": false
                    }
                  }
                }
              }
            }
          },
          "included": false
        },
        "paperReview.fixChatGPTWebLatex": {
          "type": "boolean",
          "default": true,
          "title": "修复 ChatGPT Web LaTeX 编译报错",
          "description": "通过调试连接显示 LaTeX 代码块源码，仅对 ChatGPT Web 生效。关闭后使用普通内联浏览器。",
          "order": 22
        },
        "paperReview.defaultAgent": {
          "type": "string",
          "enum": [
            "codex",
            "claude-code",
            "other"
          ],
          "enumItemLabels": [
            "Codex",
            "Claude Code",
            "其他"
          ],
          "default": "codex",
          "description": "Agent 按钮的默认目标；“其他”打开自定义入口。",
          "order": 10
        },
        "paperReview.customAgent": {
          "type": "object",
          "required": [
            "name",
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "extensionId": {
              "type": "string"
            },
            "args": {
              "type": "array"
            }
          },
          "default": {
            "name": "Codex",
            "extensionId": "openai.chatgpt",
            "command": "chatgpt.newCodexPanel"
          },
          "restricted": true,
          "order": 110,
          "markdownDescription": "自定义 Agent 的名称和命令。[检测已安装 Agent](command:paperReview.configureAgent)"
        },
        "paperReview.defaultWeb": {
          "type": "string",
          "enum": [
            "gpt",
            "claude",
            "other"
          ],
          "enumItemLabels": [
            "ChatGPT Web",
            "Claude Web",
            "其他"
          ],
          "default": "gpt",
          "description": "Web 按钮的默认目标；“其他”打开自定义入口。",
          "order": 20
        },
        "paperReview.customWeb": {
          "type": "object",
          "required": [
            "name",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "default": {
            "name": "ChatGPT Web",
            "url": "https://chatgpt.com/"
          },
          "description": "自定义 Web 的名称和 HTTP(S) 地址。",
          "order": 120
        },
        "paperReview.paperCompile": {
          "type": "string",
          "enum": [
            "windows",
            "mac",
            "other"
          ],
          "enumItemLabels": [
            "Windows",
            "macOS",
            "其他"
          ],
          "default": "windows",
          "description": "首次按系统选择；“其他”打开自定义方案列表。",
          "order": 30,
          "scope": "machine",
          "restricted": true,
          "title": "编译平台"
